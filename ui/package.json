{
  "name": "kestrel-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "esbuild test/op-seam.test.ts test/collision.test.ts test/tokens-layering.test.ts --bundle --platform=node --format=esm --external:@tauri-apps/api/core --outdir=/tmp/opencode/kestrel-tests --log-level=warning && node --test /tmp/opencode/kestrel-tests/",
    "test:tokens": "npm run test:tokens-only",
    "test:tokens-only": "esbuild test/tokens-layering.test.ts --bundle --platform=node --format=esm --outdir=/tmp/opencode/kestrel-tests-tokens --log-level=warning && node --test /tmp/opencode/kestrel-tests-tokens/",
    "audit:tokens": "node test/token-audit.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "=2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "typescript": "~5.9",
    "vite": "^6.3"
  }
}
